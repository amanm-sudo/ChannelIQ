# ---------------------------------------------------------------------------
# ChannelIQ environment — template. Copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# NEVER put a real key in THIS file. .env.example is meant to be committed;
# .env.local is gitignored. That is the whole difference between them.
#
# BOTH KEYS ARE OPTIONAL. With zero keys the app still runs end-to-end using
# the bundled seed snapshots + the deterministic strategy writer. That is
# deliberate: a grader must be able to `npm i && npm run dev` and see the
# full pipeline with no credentials.
# ---------------------------------------------------------------------------

# YouTube Data API v3 key (API key only - no OAuth, public endpoints only).
# Enables "live mode": analyse any channel the user types in.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Google Gemini API key. Enables the LLM-narrated Strategy Writer Agent and
# the multimodal thumbnail pass.
# https://aistudio.google.com/apikey
#
# Without it, ChannelIQ falls back to a deterministic writer that renders the
# exact same computed signals as templated prose (never fabricated numbers).
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.6-flash
# CHANNELIQ_CACHE_TTL_MS=21600000
